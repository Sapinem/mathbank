# === Database ===
# PostgreSQL 18 (target; MathBank :5433)
DATABASE_URL=postgresql://mathbank:***@localhost:5433/mathbank
# DB uji untuk tes integrasi (`pnpm test:db`) — BUKAN DB dev. Lihat docs/STRATEGI-TES.md.
TEST_DATABASE_URL=postgresql://mathbank:***@localhost:5433/mathbank_test

# === Auth (Better Auth) ===
BETTER_AUTH_SECRET=ganti-...jang
BETTER_AUTH_URL=http://localhost:3000

# === Deployment / HTTPS ===
# Set 'true' HANYA bila app disajikan via HTTPS (di balik reverse-proxy TLS).
# Mengaktifkan CSP 'upgrade-insecure-requests' + HSTS. Biarkan false untuk HTTP
# polos (dev/LAN) — jika tidak, aset (CSS/JS) gagal dimuat saat diakses via HTTP.
APP_HTTPS=false

# Dev: lewati login (aktor admin palsu untuk pengembangan UI).
# HANYA untuk dev. Di produksi biarkan kosong/false.
AUTH_DEV_BYPASS=false

# === Embedding (BGE-M3) ===
BGE_M3_SERVICE_URL=http://localhost:8080

# === Storage Media ===
MEDIA_STORAGE_PATH=./storage/media

# === LaTeX/TikZ ===
TIKZ_TMP_ROOT=/tmp/mathbank-tikz

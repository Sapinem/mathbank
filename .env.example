# === Database ===
# PostgreSQL 18 (target; MathBank :5433)
# GANTI `GANTI_PASSWORD` dengan password role `mathbank` yang sebenarnya.
# Nilai `***` (bintang) BUKAN placeholder yang bisa dipakai — itu password salah
# dan menyebabkan `password authentication failed for user "mathbank"`.
# Setel/reset password role + verifikasi: lihat docs/STRATEGI-TES.md §5.
DATABASE_URL=postgresql://mathbank:GANTI_PASSWORD@localhost:5433/mathbank
# DB uji untuk tes integrasi (`pnpm test:db`) — BUKAN DB dev. Lihat docs/STRATEGI-TES.md.
TEST_DATABASE_URL=postgresql://mathbank:GANTI_PASSWORD@localhost:5433/mathbank_test

# === Auth (Better Auth) ===
BETTER_AUTH_SECRET=ganti-...jang
# URL dasar app. Produksi: domain utama. Dev: http://localhost:3000 / :3001.
BETTER_AUTH_URL=https://b.iyo.my.id

# URL publik app (dipakai trustedOrigins auth & tautan absolut). Domain utama: https://b.iyo.my.id
APP_URL=https://b.iyo.my.id

# Origin dev tambahan (pisah koma) — host LAN agar `next dev` bisa diakses dari
# HP/perangkat lain tanpa diblokir cross-origin Next 16. Contoh: 192.168.18.100
ALLOWED_DEV_ORIGINS=192.168.18.100

# === Deployment / HTTPS ===
# Set 'true' HANYA bila app disajikan via HTTPS (di balik reverse-proxy TLS).
# Mengaktifkan CSP 'upgrade-insecure-requests' + HSTS. Biarkan false untuk HTTP
# polos (dev/LAN) — jika tidak, aset (CSS/JS) gagal dimuat saat diakses via HTTP.
APP_HTTPS=false

# Guard invarian DB saat startup (src/instrumentation.ts).
# false (default): hanya log ERROR bila trigger/CHECK/HNSW/uuidv7 hilang.
# true: GAGALKAN startup — dipakai CI/staging sensitif (produksi biasanya false).
STRICT_INVARIANTS=false

# Lingkungan aplikasi (selain NODE_ENV) — pagar kedua dev-bypass.
# development | staging | production. Wajib 'staging'/'production' agar
# AUTH_DEV_BYPASS TIDAK bocor hak admin di UAT/staging.
APP_ENV=development

# Dev: lewati login (aktor admin palsu untuk pengembangan UI).
# HANYA untuk dev. Di produksi biarkan kosong/false.
AUTH_DEV_BYPASS=false

# Nonaktifkan guard redirect ke /login pada layout (app). Dipakai e2e.
# Biarkan kosong di dev/demo agar login benar-benar diminta.
AUTH_GUARD_DISABLED=false

# Demo: izinkan login demo (pil akun demo) JUGA di produksi. Mati bila kosong.
# HANYA untuk keperluan demo/presentasi. Kosongkan di produksi sungguhan.
DEMO_LOGIN=
# Demo publik (pagar kedua, Fase 2): WAJIB `true` BERSAMA `DEMO_LOGIN=enabled`
# agar quick-login hidup di lingkungan production-like (NODE_ENV=production
# atau APP_ENV=production/staging). Flag ini HANYA untuk deployment yang
# memang server demo publik, BUKAN produksi sungguhan. Bila salah satu flag
# kosong/false, quick-login mati total di production/staging.
# Default: kosong (mati). Jangan set ini di docker-compose produksi.
DEMO_LOGIN_PUBLIC=

# === Embedding (BGE-M3, service lokal) ===
# Base URL service embedding — kontrak OpenAI (`POST /v1/embeddings`, `GET /health`).
# Default: service FastAPI BGE-M3 lokal (dim 1024). Ollama juga kompatibel:
# http://localhost:11434 (memakai `/v1/embeddings` yang sama).
BGE_M3_SERVICE_URL=http://127.0.0.1:3005
BGE_M3_MODEL=bge-m3
# Batas waktu panggilan embed (ms). Cold start model CPU bisa ~60 dtk.
BGE_M3_TIMEOUT_MS=120000

# === Enkripsi rahasia pengaturan (M10) ===
# 32 byte: hex 64 char ATAU base64. Hasilkan: openssl rand -hex 32
SETTINGS_ENC_KEY=

# === Storage Media ===
MEDIA_STORAGE_PATH=./storage/media

# === LaTeX/TikZ ===
TIKZ_TMP_ROOT=/tmp/mathbank-tikz

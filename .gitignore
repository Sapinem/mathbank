# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.new/
/.next.old/
/out/

# production
/build

# misc
.DS_Store
*.pem

# backups DB (dump bisa memuat data nyata — JANGAN di-commit)
/backups/

# media runtime (diunggah pengguna; data, bukan kode). Jalur backup/recovery:
# rsync/restic ke lokasi terpisah (docs/BACKUP-RECOVERY.md §3) + named volume
# `media_data` di docker-compose.yml. Lihat juga konstanta #22 (rahasia tak di kode).
/storage/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# artefak audit & dump lokal (BUKAN kode — jangan di-commit; lihat MAT-115)
/.tmp-audit/
/.tmp-*/
*.dump
*.dump.gz
*.sql.gz
/*.png
/*.jpg
/screenshots/
/audit-output/

# skrip diagnostik lokal (dev-only, banyak, tak dipakai CI). Bila ada yang
# layak permanen: pindahkan ke `scripts/` (di luar `scripts/dev/`) lalu commit.
/scripts/dev/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Log runtime skrip operasional (embedding, ingest) — bukan artefak repo
logs/

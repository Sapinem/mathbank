# Contoh env untuk docker compose (M16).
# SALIN menjadi `.env.docker` lalu isi nilai NYATA. JANGAN commit `.env.docker`.
#
#   cp .env.docker.example .env.docker

# --- Database (PostgreSQL + pgvector, service "db") ---
POSTGRES_USER=mathbank
# WAJIB: ganti dengan password kuat. JANGAN pakai contoh ini.
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=mathbank

# --- Aplikasi ---
# WAJIB: >= 32 byte acak. Buat: openssl rand -hex 32
BETTER_AUTH_SECRET=changeme-openssl-rand-hex-32
# WAJIB: 32-byte hex (64 karakter). Buat: openssl rand -hex 32
SETTINGS_ENC_KEY=changeme-64-hex-characters-untuk-enkripsi-pengaturan
# URL publik aplikasi (harus sama dengan domain Caddy).
BETTER_AUTH_URL=https://b.iyo.my.id
# true bila di balik TLS (Caddy) → aktifkan HSTS + upgrade-insecure-requests.
APP_HTTPS=true

# --- Caddy / TLS ---
APP_DOMAIN=b.iyo.my.id
ACME_EMAIL=admin@iyo.my.id

# --- Opsional ---
# Origin dev yang diizinkan (LAN), pisah koma. Kosongkan di produksi publik.
ALLOWED_DEV_ORIGINS=
# Layanan embedding (bila di luar compose).
BGE_M3_SERVICE_URL=
BGE_M3_MODEL=bge-m3
# Level log (debug|info|warn|error).
LOG_LEVEL=info
# Token untuk /api/metrics (biarkan kosong = nonaktif di produksi).
METRICS_TOKEN=

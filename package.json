{
  "name": "mathbank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "tsx scripts/test-db.ts",
    "test:all": "pnpm test && pnpm test:db",
    "smoke:prod": "tsx scripts/smoke-prod.ts",
    "smoke:prod:demo": "EXPECT_DEMO_LOGIN=1 tsx scripts/smoke-prod.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-ensure-extensions.ts && drizzle-kit migrate && pnpm db:safety",
    "db:extensions": "tsx scripts/db-ensure-extensions.ts",
    "db:safety": "tsx scripts/db-apply-safety.ts",
    "db:push": "node scripts/db-push-gate.mjs && tsx scripts/db-ensure-extensions.ts && drizzle-kit push && pnpm db:safety && pnpm db:verify",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx scripts/db-verify.ts",
    "metrics:snapshot": "tsx scripts/snapshot-metrics.ts",
    "theme:build": "tsx scripts/theme/build.ts",
    "theme:check": "tsx scripts/theme/check.ts",
    "seed:taxonomy": "tsx scripts/seed-taxonomy.ts",
    "seed:questions": "tsx scripts/seed-questions.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "e2e:manual": "playwright test",
    "e2e:manual:ui": "playwright test --ui",
    "start:lan": "next start -H 0.0.0.0",
    "check": "pnpm theme:check && pnpm lint:names && pnpm lint:authz && pnpm openapi:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build",
    "security:secrets": "node scripts/secret-scan.mjs --all",
    "security:advisories": "tsx scripts/security-advisories.ts",
    "prepare": "node scripts/install-hooks.mjs",
    "mcp:stdio": "tsx src/mcp-stdio.ts",
    "backup:db": "node scripts/backup-db.mjs",
    "restore:check": "node scripts/restore-check.mjs",
    "media:verify-img": "tsx scripts/verify-img-serve.ts",
    "media:verify-hygiene": "tsx scripts/verify-hygiene-live.ts",
    "media:register-orphans": "tsx scripts/register-orphan-files.ts",
    "lint:names": "node scripts/check-names.mjs",
    "lint:authz": "tsx scripts/check-authz.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "^1.7.12",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@dnd-kit/react": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  }
}

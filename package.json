{
  "name": "mathbank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "tsx scripts/test-db.ts",
    "test:all": "pnpm test && pnpm test:db",
    "smoke:prod": "tsx scripts/smoke-prod.ts",
    "smoke:prod:demo": "EXPECT_DEMO_LOGIN=1 tsx scripts/smoke-prod.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-ensure-extensions.ts && drizzle-kit migrate && pnpm db:safety",
    "db:extensions": "tsx scripts/db-ensure-extensions.ts",
    "db:safety": "tsx scripts/db-apply-safety.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx scripts/db-verify.ts",
    "theme:build": "tsx scripts/theme/build.ts",
    "theme:check": "tsx scripts/theme/check.ts",
    "seed:taxonomy": "tsx scripts/seed-taxonomy.ts",
    "seed:questions": "tsx scripts/seed-questions.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "e2e:manual": "playwright test",
    "e2e:manual:ui": "playwright test --ui",
    "start:lan": "next start -H 0.0.0.0",
    "check": "pnpm theme:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "^1.7.6",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@dnd-kit/react": "^0.5.0",
    "@tanstack/react-query": "^5.104.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.22.0"
}
